PROJECT_NAME="CareBridge AI"
API_V1_STR="/api"
SECRET_KEY="your-jwt-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Server & Environment Configuration
ENVIRONMENT="production" # "development" | "production"
PORT=8080
AUTO_SEED_DEMO_DATA=false

# Database Configuration
# Local SQLite: sqlite:///./carebridge.db
# Cloud SQL PostgreSQL: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@/<DB_NAME>?host=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
DATABASE_URL="postgresql+psycopg2://carebridge_user:dbpassword@127.0.0.1:5432/carebridge"

# Notification & Reminder Engine (SMTP or mock)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="alerts@carebridge-ai.com"
EMAILS_FROM_NAME="CareBridge AI Alerts"
ENABLE_EMAIL_ALERTS=false
GRACE_PERIOD_MINUTES=30

# AI Configuration (Official Groq API Integration)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_PROVIDER="groq"
AI_API_KEY=""
GROK_API_KEY=""

# Application & CORS Settings
# Provide comma-separated origins or JSON array:
CORS_ORIGINS=["https://carebridge-frontend-<hash>-uc.a.run.app"]
